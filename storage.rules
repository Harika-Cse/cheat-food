rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Food item images: publicly readable, only admins can upload/delete
    match /food_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User profile pictures: user can write their own
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
