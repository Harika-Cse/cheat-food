rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if the user has an admin role
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users Collection: Users can read and write their own profile; Admins have full access
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // User Sub-collections: Addresses & Favorites
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /favorites/{foodId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Categories: Publicly readable; Only admins can create, update, delete
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Food Items: Publicly readable; Only admins / vendors can write
    match /foods/{foodId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      // Reviews sub-collection: Any authenticated user can read & create review
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // Vendors: Publicly readable; Only admins can modify
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Users can read and create their own orders; Admins can read all and update statuses
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.status == 'Cancelled');
      allow delete: if isAdmin();
    }

    // Coupons: Authenticated users can read active coupons; Only admin can write
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
